{
  "name": "Jordan Labour Market",
  "dataColors": [
    "#0F7A4A",
    "#C8102E",
    "#2F6DB5",
    "#B7802A",
    "#6B5CA5",
    "#2A9D8F",
    "#8A8F98",
    "#D97B29"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#0F7A4A",
  "good": "#0F7A4A",
  "neutral": "#B7802A",
  "bad": "#C8102E",
  "maximum": "#7A0A1C",
  "center": "#E8B4BC",
  "minimum": "#FBEFF1",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2937" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2937" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#4B5563" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 32, "color": "#1F2937" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E5E0D5" } }, "radius": 12 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 12, "bottom": 12, "left": 14, "right": 14 }],
        "title": [{ "show": true, "fontFace": "Segoe UI Semibold", "fontSize": 12, "fontColor": { "solid": { "color": "#1F2937" } } }],
        "subTitle": [{ "fontFace": "Segoe UI", "fontSize": 10, "fontColor": { "solid": { "color": "#6B7280" } } }],
        "valueAxis": [{ "gridlineShow": true, "gridlineColor": { "solid": { "color": "#EEEAE2" } }, "gridlineThickness": 1, "labelColor": { "solid": { "color": "#6B7280" } }, "fontSize": 9 }],
        "categoryAxis": [{ "gridlineShow": false, "labelColor": { "solid": { "color": "#6B7280" } }, "fontSize": 9 }],
        "legend": [{ "labelColor": { "solid": { "color": "#4B5563" } }, "fontSize": 9 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F1EA" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F4F1EA" } }, "transparency": 0 }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    }
  }
}
